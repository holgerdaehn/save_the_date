<Window x:Class="SaveTheDate.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nach Datum umbenennen" Width="940" Height="720" MinWidth="720" MinHeight="560" WindowStartupLocation="CenterOwner">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="18,14,18,8">
            <TextBlock Text="Nach Datum umbenennen" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="Intro" Style="{StaticResource Secondary}"/>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Padding="18,12" BorderThickness="0,1,0,0" BorderBrush="#22808080">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Abbrechen" Padding="16,7" Margin="0,0,8,0" IsCancel="True"/>
                    <Button x:Name="BtnGo" Content="Umbenennen" Style="{StaticResource Primary}" Padding="22,8" IsEnabled="False" Click="OnGo"/>
                </StackPanel>
                <TextBlock x:Name="Summary" Style="{StaticResource Secondary}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <Grid Margin="18,0,18,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Muster" VerticalAlignment="Center" Margin="0,0,16,4"/>
                <TextBox x:Name="TxTemplate" Grid.Column="1" Margin="0,0,8,4" VerticalContentAlignment="Center" TextChanged="OnOpt"/>
                <ComboBox x:Name="CmbPreset" Grid.Column="2" Margin="0,0,0,4" SelectionChanged="OnPreset" ToolTip="Vorlage wählen"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Secondary}" Margin="2,0,0,8"
                           Text="Platzhalter: {JJJJ} {MM} {TT} {hh} {mm} {ss} · {Name} = alter Name · {Nr} = Zähler"/>

                <TextBlock Grid.Row="2" Text="Datum" VerticalAlignment="Center" Margin="0,0,16,8"/>
                <ComboBox x:Name="CmbSource" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" SelectedIndex="0" Margin="0,0,0,8" SelectionChanged="OnOpt">
                    <ComboBoxItem Content="Aufnahme, Dateiname oder Änderung"/>
                    <ComboBoxItem Content="Aufnahme, sonst Änderung"/>
                    <ComboBoxItem Content="Änderungsdatum"/>
                    <ComboBoxItem Content="Erstelldatum"/>
                </ComboBox>

                <CheckBox x:Name="CkLower" Grid.Row="3" Grid.ColumnSpan="3" Content="Endung klein schreiben (.JPG → .jpg)" IsChecked="True" Click="OnOpt"/>
                <CheckBox x:Name="CkMedia" Grid.Row="4" Grid.ColumnSpan="3" Content="Nur Fotos und Videos" IsChecked="True" Margin="0,4,0,0" Click="OnOpt"/>
            </Grid>
            <DataGrid x:Name="Table" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      GridLinesVisibility="None" HeadersVisibility="Column" RowHeight="30" BorderThickness="0"
                      AlternatingRowBackground="#0C808080" Background="Transparent" RowBackground="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Bisher" Binding="{Binding Item.Name}" Width="*" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="Neu" Binding="{Binding Display}" Width="*" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="Ordner" Binding="{Binding Item.Folder}" Width="*" ElementStyle="{StaticResource Cell}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
