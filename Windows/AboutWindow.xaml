<Window x:Class="SaveTheDate.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Über Save the Date" Width="540" Height="700" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,8,24,16">
            <Button Content="Anleitung" Padding="16,7" Margin="0,0,8,0" Click="OnHelp"/>
            <Button Content="Schließen" Padding="16,7" IsCancel="True" IsDefault="True"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,26,32,8">
                <Border Width="96" Height="96" CornerRadius="22" HorizontalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#4DB0FF" Offset="0"/>
                            <GradientStop Color="#0A5AF2" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="52" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Save the Date" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                <TextBlock x:Name="TxVersion" Style="{StaticResource Secondary}" HorizontalAlignment="Center"/>
                <TextBlock TextAlignment="Center" Margin="0,14,0,0" TextWrapping="Wrap"
                           Text="Datum, Aufnahmezeit und Standort von Fotos und Dateien ändern – dazu Duplikate finden, Fotos nach Jahr und Monat sortieren und überflüssige Dateien aufräumen."/>

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Entwickler" Style="{StaticResource Secondary}" Margin="0,3,0,8"/>
                    <TextBlock Grid.Column="1" Text="Kundida (Holger Dähn)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="1" Text="Version" Style="{StaticResource Secondary}" Margin="0,3,0,8"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxVersion2" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="2" Text="Copyright" Style="{StaticResource Secondary}" Margin="0,3,0,8"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="© 2026 Kundida (Holger Dähn). Veröffentlicht unter der MIT-Lizenz." TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="3" Text="System" Style="{StaticResource Secondary}" Margin="0,3,0,8"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxSystem" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="4" Text="Voraussetzung" Style="{StaticResource Secondary}" Margin="0,3,0,8"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Windows 10 (1809) oder neuer, 64 Bit" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="5" Text="Projektseite" Style="{StaticResource Secondary}" Margin="0,3,0,0"/>
                    <TextBlock Grid.Row="5" Grid.Column="1">
                        <Hyperlink NavigateUri="https://github.com/holgerdaehn/save_the_date" RequestNavigate="OnLink">github.com/holgerdaehn/save_the_date</Hyperlink>
                    </TextBlock>
                </Grid>

                <Border Height="1" Background="#22808080" Margin="0,20,0,16"/>
                <TextBlock Text="Datenschutz" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Style="{StaticResource Secondary}" FontSize="13"
                           Text="Alle Dateien werden ausschließlich lokal auf diesem Computer verarbeitet; es werden keine Daten an den Entwickler übertragen. Für Karte und Ortssuche werden Kartenausschnitte und Suchbegriffe an die Server von OpenStreetMap gesendet."/>

                <TextBlock Text="Drittanbieter und Datenquellen" FontWeight="SemiBold" Margin="0,16,0,4"/>
                <TextBlock Style="{StaticResource Secondary}" FontSize="13">
                    Kartendaten © OpenStreetMap-Mitwirkende (Open Database License). Ortssuche über Nominatim.
                    <LineBreak/>
                    <Hyperlink NavigateUri="https://www.openstreetmap.org/copyright" RequestNavigate="OnLink">openstreetmap.org/copyright</Hyperlink>
                </TextBlock>

                <TextBlock Text="Hinweis" FontWeight="SemiBold" Margin="0,16,0,4"/>
                <TextBlock Style="{StaticResource Secondary}" FontSize="13" Margin="0,0,0,8"
                           Text="Die Software wird ohne Gewähr bereitgestellt. Vor größeren Änderungen wird eine Datensicherung empfohlen. Gelöschte Dateien werden in den Papierkorb gelegt."/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
