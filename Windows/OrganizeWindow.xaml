<Window x:Class="SaveTheDate.OrganizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nach Datum sortieren" Width="940" Height="720" MinWidth="720" MinHeight="560" WindowStartupLocation="CenterOwner">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="18,14,18,8">
            <TextBlock Text="Nach Datum sortieren" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="Intro" Style="{StaticResource Secondary}"/>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Padding="18,12" BorderThickness="0,1,0,0" BorderBrush="#22808080">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Abbrechen" Padding="16,7" Margin="0,0,8,0" IsCancel="True"/>
                    <Button x:Name="BtnGo" Content="Ablegen" Style="{StaticResource Primary}" Padding="22,8" IsEnabled="False" Click="OnGo"/>
                </StackPanel>
                <TextBlock x:Name="Summary" Style="{StaticResource Secondary}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <Grid Margin="18,0,18,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Zielordner" VerticalAlignment="Center" Margin="0,0,16,8"/>
                <TextBox x:Name="TxRoot" Grid.Column="1" IsReadOnly="True" Margin="0,0,8,8" VerticalContentAlignment="Center"/>
                <Button Grid.Column="2" Content="Wählen …" Padding="12,5" Margin="0,0,0,8" Click="OnChoose"/>

                <TextBlock Grid.Row="1" Text="Struktur" VerticalAlignment="Center" Margin="0,0,16,8"/>
                <ComboBox x:Name="CmbPattern" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" SelectedIndex="0" Margin="0,0,0,8" SelectionChanged="OnOpt">
                    <ComboBoxItem Content="JJJJ/MM"/>
                    <ComboBoxItem Content="JJJJ/MM/TT"/>
                    <ComboBoxItem Content="JJJJ-MM"/>
                </ComboBox>

                <TextBlock Grid.Row="2" Text="Datum" VerticalAlignment="Center" Margin="0,0,16,8"/>
                <ComboBox x:Name="CmbSource" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" SelectedIndex="0" Margin="0,0,0,8" SelectionChanged="OnOpt">
                    <ComboBoxItem Content="Aufnahme, sonst Änderung"/>
                    <ComboBoxItem Content="Änderungsdatum"/>
                    <ComboBoxItem Content="Erstelldatum"/>
                </ComboBox>

                <CheckBox x:Name="CkMedia" Grid.Row="3" Grid.ColumnSpan="3" Content="Nur Fotos und Videos" IsChecked="True" Click="OnOpt"/>
                <CheckBox x:Name="CkCopy" Grid.Row="4" Grid.ColumnSpan="3" Content="Kopieren statt verschieben" Click="OnOpt"/>
                <CheckBox x:Name="CkEmpty" Grid.Row="5" Grid.ColumnSpan="3" Content="Leere Quellordner entfernen" IsChecked="True" Click="OnOpt"/>
            </Grid>
            <DataGrid x:Name="Table" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      GridLinesVisibility="None" HeadersVisibility="Column" RowHeight="30" BorderThickness="0"
                      AlternatingRowBackground="#0C808080" Background="Transparent" RowBackground="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Datei" Binding="{Binding Item.Name}" Width="260" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="Von" Binding="{Binding Item.Folder}" Width="*" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="Nach" Binding="{Binding Display}" Width="260" ElementStyle="{StaticResource Cell}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
