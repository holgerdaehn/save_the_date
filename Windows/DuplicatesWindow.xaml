<Window x:Class="SaveTheDate.DuplicatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Duplikate" Width="1000" Height="700" MinWidth="760" MinHeight="480" WindowStartupLocation="CenterOwner">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="18,14,18,10">
            <TextBlock Text="Duplikate" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource Secondary}" Text="Gleicher Inhalt (SHA-256) – egal, wie die Dateien heißen. Gelöscht wird nur in den Papierkorb."/>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Padding="18,12" BorderThickness="0,1,0,0" BorderBrush="#22808080">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Schließen" Padding="16,7" Margin="0,0,8,0" IsCancel="True"/>
                    <Button x:Name="BtnTrash" Content="In Papierkorb legen" Style="{StaticResource Danger}" Padding="18,8"
                            IsEnabled="False" Click="OnTrash"/>
                </StackPanel>
                <ComboBox x:Name="CmbKeep" Width="220" SelectedIndex="0" VerticalAlignment="Center" SelectionChanged="OnKeepChanged">
                    <ComboBoxItem Content="Ältestes behalten"/>
                    <ComboBoxItem Content="Neuestes behalten"/>
                    <ComboBoxItem Content="Kürzesten Pfad behalten"/>
                    <ComboBoxItem Content="Erstes behalten"/>
                </ComboBox>
                <TextBlock x:Name="Summary" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="14,0"/>
            </DockPanel>
        </Border>
        <Grid>
            <DataGrid x:Name="Table" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False"
                      SelectionMode="Single" GridLinesVisibility="None" HeadersVisibility="Column" RowHeight="34"
                      BorderThickness="0" Background="Transparent" RowBackground="Transparent" Visibility="Collapsed">
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="10,12,0,4"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Löschen" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Delete, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Name" Binding="{Binding Item.Name}" IsReadOnly="True" Width="260" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="Ordner" Binding="{Binding Item.Folder}" IsReadOnly="True" Width="*" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="Geändert" Binding="{Binding Item.ModifiedText}" IsReadOnly="True" Width="150" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="" Binding="{Binding Verdict}" IsReadOnly="True" Width="80" ElementStyle="{StaticResource Cell}"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel x:Name="Wait" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar x:Name="Prog" Width="300" Height="6" Maximum="100"/>
                <TextBlock Text="Vergleiche Dateien …" Style="{StaticResource Secondary}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
            <TextBlock x:Name="NoneFound" Visibility="Collapsed" Text="Keine Duplikate gefunden" FontSize="18" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </DockPanel>
</Window>
